{
  "$id": "https://schemas.tabchef.invalid/config.json",
  "type": "object",
  "required": [
    "version",
    "rules",
    "recipes",
    "order",
    "tables",
    "dedupe",
    "dryRun"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "rule.json"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "enabled",
          "params",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "rule.json#/$defs/id"
          },
          "enabled": {
            "type": "boolean"
          },
          "params": {
            "type": "object"
          },
          "source": {
            "enum": [
              "builtin",
              "user"
            ]
          },
          "body": {
            "type": "object",
            "$comment": "Loose on purpose (R41): stored bodies are checked in TS with validateRecipe (src/core/lang/schema.ts); an invalid one disables its recipe (repairConfig) instead of failing the whole config."
          }
        }
      }
    },
    "order": {
      "type": "array",
            "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "dedupe": {
      "type": "object",
      "required": [
        "mode",
        "keep",
        "stripParams",
        "stripFragment",
        "ignoreTrailingSlash",
        "canonicalizers",
        "followFragment",
        "allowDuplicates",
        "alwaysSwitchSites",
        "includeIncognito",
        "scope",
        "urlTransforms",
        "fragmentOverrides",
        "matchTitle",
        "titleOverrides"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "always-switch",
            "ask",
            "off"
          ]
        },
        "keep": {
          "const": "existing"
        },
        "stripParams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stripFragment": {
          "type": "boolean"
        },
        "ignoreTrailingSlash": {
          "type": "boolean"
        },
        "canonicalizers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "followFragment": {
          "type": "boolean"
        },
        "allowDuplicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alwaysSwitchSites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeIncognito": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "all-windows",
            "same-window"
          ]
        },
        "urlTransforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "replacement"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              },
              "flags": {
                "type": "string"
              }
            }
          }
        },
        "fragmentOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "keepFragment"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string"
              },
              "keepFragment": {
                "type": "boolean"
              }
            }
          }
        },
        "matchTitle": {
          "type": "boolean"
        },
        "titleOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "matchTitle"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string"
              },
              "matchTitle": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "dryRun": {
      "type": "boolean"
    }
  }
}
