{
  "$id": "https://schemas.tabchef.invalid/recipe-rule.json",
  "$comment": "@generated by scripts/gen-validator.mjs from src/core/lang/rule.schema.json. Do not edit. Typed leaves also accept an exact {params.<name>} placeholder (R14); strings are capped at 2048 characters, patterns and regexes at 500.",
  "$defs": {
    "pattern": {
      "type": "string",
      "maxLength": 500
    },
    "duration": {
      "type": "string",
      "maxLength": 2048
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "cond": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pattern"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pattern"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/pattern"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "opener"
          ],
          "additionalProperties": false,
          "properties": {
            "opener": {
              "$ref": "#/$defs/cond"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pinned"
          ],
          "additionalProperties": false,
          "properties": {
            "pinned": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "recipe.json#/$defs/placeholder"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "audible"
          ],
          "additionalProperties": false,
          "properties": {
            "audible": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "recipe.json#/$defs/placeholder"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "age"
          ],
          "additionalProperties": false,
          "properties": {
            "age": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gt": {
                  "$ref": "#/$defs/duration"
                },
                "lt": {
                  "$ref": "#/$defs/duration"
                }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pageText"
          ],
          "additionalProperties": false,
          "properties": {
            "pageText": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "$comment": "M3: source.<name> (a field of the rule's source), extract.<name> (an extract of the rule) or project.<name> (rejected by compileProgram until T15, M3-R11). `value` may be {ago: <duration>} with < or >. Missing data is unknown (M3-R8).",
              "type": "object",
              "required": [
                "field",
                "op",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^(source|extract|project)\\.[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "op": {
                  "oneOf": [
                    {
                      "enum": [
                        "==",
                        "!=",
                        "<",
                        ">",
                        "in",
                        "matches"
                      ]
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "value": {}
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/cond"
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "object",
              "required": [
                "title",
                "color"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 2048
                },
                "color": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "collapsed": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "sortGroups": {
                  "oneOf": [
                    {
                      "enum": [
                        "creation",
                        "alphabetical"
                      ]
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "strict": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "merge": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "anchors": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "dedupe"
          ],
          "additionalProperties": false,
          "properties": {
            "dedupe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "oneOf": [
                    {
                      "enum": [
                        "always-switch",
                        "ask",
                        "off"
                      ]
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "followFragment": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "keepFragment": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                },
                "matchTitle": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "close"
          ],
          "additionalProperties": false,
          "properties": {
            "close": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "after": {
                  "$ref": "#/$defs/duration"
                },
                "mode": {
                  "oneOf": [
                    {
                      "enum": [
                        "auto",
                        "suggest"
                      ]
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "showInView"
          ],
          "additionalProperties": false,
          "properties": {
            "showInView": {
              "type": "object",
              "required": [
                "view"
              ],
              "additionalProperties": false,
              "properties": {
                "view": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "assignProject"
          ],
          "additionalProperties": false,
          "properties": {
            "assignProject": {
              "$comment": "M3, recipe rules only (M3-R15): the tab is a candidate for the recipe's project `key` (a template).",
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "create": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "recipe.json#/$defs/placeholder"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "connectionId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        {
          "$ref": "recipe.json#/$defs/placeholder"
        }
      ]
    },
    "needs": {
      "$comment": "Recipe-level and rule-level needs (one definition, M3-R13). connections and anyOf (alternatives, best first) are rejected by compileProgram as not supported yet until T12 (M3-R12).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1
              }
            },
            {
              "$ref": "recipe.json#/$defs/placeholder"
            }
          ]
        },
        "permissions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "recipe.json#/$defs/permission"
              }
            },
            {
              "$ref": "recipe.json#/$defs/placeholder"
            }
          ]
        },
        "connections": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/connectionId"
              }
            },
            {
              "$ref": "recipe.json#/$defs/placeholder"
            }
          ]
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/needs"
          }
        }
      }
    },
    "source": {
      "$comment": "M3, recipe rules only (M3-R15): query (= T8's SOURCE_QUERIES keys, M3-R29) run on a connection; args are templates; fields map a name (read as source.<name>) to a dot path into the result. No page fallback adapter until T11 (M3-R58).",
      "type": "object",
      "required": [
        "connection",
        "query",
        "args",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "connection": {
          "$ref": "#/$defs/connectionId"
        },
        "query": {
          "oneOf": [
            {
              "enum": [
                "github.pull_request",
                "github.search_prs_by_key",
                "jira.issue",
                "jira.projects"
              ]
            },
            {
              "$ref": "recipe.json#/$defs/placeholder"
            }
          ]
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              {
                "$ref": "recipe.json#/$defs/placeholder"
              }
            ]
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "id",
    "name",
    "enabled",
    "match",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "maxLength": 2048
    },
    "enabled": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "recipe.json#/$defs/placeholder"
        }
      ]
    },
    "dryRun": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "recipe.json#/$defs/placeholder"
        }
      ]
    },
    "needs": {
      "$comment": "Rule-level needs (T10, R5): an unmet one pauses this rule key only. Recipe rules only; compileProgram rejects them on user rules (R44).",
      "$ref": "#/$defs/needs"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "trigger": {
      "type": "object",
      "required": [
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "enum": [
                      "created",
                      "committed",
                      "pageText",
                      "schedule",
                      "groupChanged",
                      "sourceUpdated"
                    ]
                  },
                  {
                    "$ref": "recipe.json#/$defs/placeholder"
                  }
                ]
              }
            },
            {
              "$ref": "recipe.json#/$defs/placeholder"
            }
          ]
        },
        "every": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "match": {
      "$ref": "#/$defs/cond"
    },
    "extract": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "from",
              "regex"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "oneOf": [
                  {
                    "enum": [
                      "url",
                      "title"
                    ]
                  },
                  {
                    "$ref": "recipe.json#/$defs/placeholder"
                  }
                ]
              },
              "regex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "required": [
              "selector"
            ],
            "additionalProperties": false,
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "attr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "required": [
              "from",
              "jiraKey"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(url|title|source\\.[A-Za-z_][A-Za-z0-9_]*)$"
                  },
                  {
                    "$ref": "recipe.json#/$defs/placeholder"
                  }
                ]
              },
              "jiraKey": {
                "$comment": "M3: Jira issue keys (T2 computes the value, M3-R21).",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "allow": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      },
                      {
                        "$ref": "recipe.json#/$defs/placeholder"
                      }
                    ]
                  },
                  "ignore": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      },
                      {
                        "$ref": "recipe.json#/$defs/placeholder"
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "$comment": "M3 T10 (M3-R58): one field of a page adapter (src/core/adapters). Its fields per adapter are checked in TS (ruleProblems).",
            "type": "object",
            "required": [
              "adapter",
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "adapter": {
                "oneOf": [
                  {
                    "enum": [
                      "github.prPage",
                      "jira.issuePage"
                    ]
                  },
                  {
                    "$ref": "recipe.json#/$defs/placeholder"
                  }
                ]
              },
              "field": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  {
                    "$ref": "recipe.json#/$defs/placeholder"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  }
}
