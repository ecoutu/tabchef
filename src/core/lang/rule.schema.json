{
  "$id": "https://schemas.tabchef.invalid/rule.json",
  "$comment": "M2 rule language (src/core/lang/types.ts). Regex/pattern/template/duration/color checks are TS post-validation (src/core/config/schema.ts; rule regexes capped at 500 characters there, enabled rules only, so stored data from laxer versions still loads). No discard/notify actions (ruling R26). Recipe rules use the derived recipe-rule.schema.generated.json: typed leaves may be {params.x} placeholders (R14), and strings are capped in the schema (2048 characters; patterns and regexes 500).",
  "$defs": {
    "pattern": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "cond": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pattern"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pattern"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/pattern"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "opener"
          ],
          "additionalProperties": false,
          "properties": {
            "opener": {
              "$ref": "#/$defs/cond"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pinned"
          ],
          "additionalProperties": false,
          "properties": {
            "pinned": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "audible"
          ],
          "additionalProperties": false,
          "properties": {
            "audible": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "age"
          ],
          "additionalProperties": false,
          "properties": {
            "age": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gt": {
                  "$ref": "#/$defs/duration"
                },
                "lt": {
                  "$ref": "#/$defs/duration"
                }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pageText"
          ],
          "additionalProperties": false,
          "properties": {
            "pageText": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "$comment": "M3: source.<name> (a field of the rule's source), extract.<name> (an extract of the rule) or project.<name> (rejected by compileProgram until T15, M3-R11). `value` may be {ago: <duration>} with < or >. Missing data is unknown (M3-R8).",
              "type": "object",
              "required": [
                "field",
                "op",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^(source|extract|project)\\.[A-Za-z_][A-Za-z0-9_]*$"
                },
                "op": {
                  "enum": [
                    "==",
                    "!=",
                    "<",
                    ">",
                    "in",
                    "matches"
                  ]
                },
                "value": {}
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/cond"
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "object",
              "required": [
                "title",
                "color"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "color": {
                  "type": "string",
                  "minLength": 1
                },
                "collapsed": {
                  "type": "boolean"
                },
                "sortGroups": {
                  "enum": [
                    "creation",
                    "alphabetical"
                  ]
                },
                "strict": {
                  "type": "boolean"
                },
                "merge": {
                  "type": "boolean"
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "dedupe"
          ],
          "additionalProperties": false,
          "properties": {
            "dedupe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "always-switch",
                    "ask",
                    "off"
                  ]
                },
                "followFragment": {
                  "type": "boolean"
                },
                "keepFragment": {
                  "type": "boolean"
                },
                "matchTitle": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "close"
          ],
          "additionalProperties": false,
          "properties": {
            "close": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "after": {
                  "$ref": "#/$defs/duration"
                },
                "mode": {
                  "enum": [
                    "auto",
                    "suggest"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "showInView"
          ],
          "additionalProperties": false,
          "properties": {
            "showInView": {
              "type": "object",
              "required": [
                "view"
              ],
              "additionalProperties": false,
              "properties": {
                "view": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "assignProject"
          ],
          "additionalProperties": false,
          "properties": {
            "assignProject": {
              "$comment": "M3, recipe rules only (M3-R15): the tab is a candidate for the recipe's project `key` (a template), then for `fallbackKey` (a template; when it renders to another key, e.g. a PR's branch key after its title key). `create` applies to both `key` and `fallbackKey`; the built-in PR rules never set it (prefix confirmation gates their joins).",
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbackKey": {
                  "type": "string",
                  "minLength": 1
                },
                "create": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    "connectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "needs": {
      "$comment": "Recipe-level and rule-level needs (one definition, M3-R13). anyOf lists alternatives, best first; PermissionsManager picks the first granted one as the rule's level (M3-R63). Alternatives do not nest (compileProgram reports it).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "recipe.json#/$defs/permission"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectionId"
          }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/needs"
          }
        }
      }
    },
    "source": {
      "$comment": "M3, recipe rules only (M3-R15): query (= T8's SOURCE_QUERIES keys, M3-R29) run on a connection; args are templates; fields map a name (read as source.<name>) to a dot path into the result. fallback names the page adapter (src/core/adapters) read when there is no usable connection (M3-R59).",
      "type": "object",
      "required": [
        "connection",
        "query",
        "args",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "connection": {
          "$ref": "#/$defs/connectionId"
        },
        "query": {
          "enum": [
            "github.pull_request",
            "github.search_prs_by_key",
            "github.issue",
            "jira.issue",
            "jira.projects"
          ]
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "fallback": {
          "type": "object",
          "required": [
            "adapter"
          ],
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "enum": [
                "github.prPage",
                "github.issuePage",
                "jira.issuePage"
              ]
            }
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "id",
    "name",
    "enabled",
    "match",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "dryRun": {
      "type": "boolean"
    },
    "needs": {
      "$comment": "Rule-level needs (T10, R5): an unmet one pauses this rule key only. Recipe rules only; compileProgram rejects them on user rules (R44).",
      "$ref": "#/$defs/needs"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "trigger": {
      "type": "object",
      "required": [
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "created",
              "committed",
              "pageText",
              "schedule",
              "groupChanged",
              "sourceUpdated"
            ]
          }
        },
        "every": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "match": {
      "$ref": "#/$defs/cond"
    },
    "extract": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "from",
              "regex"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "enum": [
                  "url",
                  "title"
                ]
              },
              "regex": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "selector"
            ],
            "additionalProperties": false,
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "attr": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "from",
              "jiraKey"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(url|title|source\\.[A-Za-z_][A-Za-z0-9_]*)$"
              },
              "jiraKey": {
                "$comment": "M3: Jira issue keys (T2 computes the value, M3-R21).",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ignore": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "from",
              "githubIssue"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(url|title|source\\.[A-Za-z_][A-Za-z0-9_]*)$"
              },
              "githubIssue": {
                "$comment": "GitHub issue keys (owner/repo#N) from an issue URL, a branch (with pattern) or a source field.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ignore": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "$comment": "M3 T10 (M3-R58): one field of a page adapter (src/core/adapters). Its fields per adapter are checked in TS (ruleProblems).",
            "type": "object",
            "required": [
              "adapter",
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "adapter": {
                "enum": [
                  "github.prPage",
                  "github.issuePage",
                  "jira.issuePage"
                ]
              },
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  }
}
