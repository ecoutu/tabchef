{
  "$id": "https://schemas.tabchef.invalid/rule.json",
  "$comment": "M2 rule language (src/core/lang/types.ts). Regex/pattern/template/duration/color checks are TS post-validation (src/core/config/schema.ts). No discard/notify actions (ruling R26).",
  "$defs": {
    "pattern": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "cond": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pattern"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pattern"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/pattern"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "opener"
          ],
          "additionalProperties": false,
          "properties": {
            "opener": {
              "$ref": "#/$defs/cond"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pinned"
          ],
          "additionalProperties": false,
          "properties": {
            "pinned": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "audible"
          ],
          "additionalProperties": false,
          "properties": {
            "audible": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "age"
          ],
          "additionalProperties": false,
          "properties": {
            "age": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gt": {
                  "$ref": "#/$defs/duration"
                },
                "lt": {
                  "$ref": "#/$defs/duration"
                }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pageText"
          ],
          "additionalProperties": false,
          "properties": {
            "pageText": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/cond"
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "object",
              "required": [
                "title",
                "color"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "color": {
                  "type": "string",
                  "minLength": 1
                },
                "collapsed": {
                  "type": "boolean"
                },
                "sortGroups": {
                  "enum": [
                    "creation",
                    "alphabetical"
                  ]
                },
                "strict": {
                  "type": "boolean"
                },
                "merge": {
                  "type": "boolean"
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "dedupe"
          ],
          "additionalProperties": false,
          "properties": {
            "dedupe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "always-switch",
                    "ask",
                    "off"
                  ]
                },
                "followFragment": {
                  "type": "boolean"
                },
                "keepFragment": {
                  "type": "boolean"
                },
                "matchTitle": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "close"
          ],
          "additionalProperties": false,
          "properties": {
            "close": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "after": {
                  "$ref": "#/$defs/duration"
                },
                "mode": {
                  "enum": [
                    "auto",
                    "suggest"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "showInView"
          ],
          "additionalProperties": false,
          "properties": {
            "showInView": {
              "type": "object",
              "required": [
                "view"
              ],
              "additionalProperties": false,
              "properties": {
                "view": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "id",
    "name",
    "enabled",
    "match",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "dryRun": {
      "type": "boolean"
    },
    "trigger": {
      "type": "object",
      "required": [
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "array",
          "minItems": 1,
                    "items": {
            "enum": [
              "created",
              "committed",
              "pageText",
              "schedule",
              "groupChanged"
            ]
          }
        },
        "every": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "match": {
      "$ref": "#/$defs/cond"
    },
    "extract": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "from",
              "regex"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "enum": [
                  "url",
                  "title"
                ]
              },
              "regex": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "selector"
            ],
            "additionalProperties": false,
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "attr": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  }
}
