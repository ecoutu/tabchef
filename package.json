    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
