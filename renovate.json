{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Toronto",
  "rangeStrategy": "pin",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Security fixes open right away, outside the weekly schedule",
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "description": "Refresh transitive dependencies (most Dependabot alerts are transitive dev tooling)",
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "lzma and yaml ship in the extension zip: fix(deps) so semantic-release releases the update",
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "WXT is pre-1.0: every minor can break, review individually",
      "matchPackageNames": ["wxt", "@wxt-dev/**"],
      "groupName": "wxt",
      "automerge": false
    },
    {
      "description": "Playwright bumps bring new Chromium builds; the weekly Chrome check also tests @latest",
      "matchPackageNames": ["@playwright/test"],
      "groupName": "playwright"
    },
    {
      "description": "Low-risk dev tooling, grouped",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!wxt", "!@wxt-dev/**", "!@playwright/test"],
      "groupName": "dev tooling (minor/patch)"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
